<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ti.songdu">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v1.14.0 在线书库：从 Gitee 私有仓拉目录与下载书籍文件 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v1.10.0 悬浮播放控件：在其他应用上层显示半圆钮/字幕卡（需用户在系统设置里授权一次） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- v1.16.0 识读：麦克风采集（端侧识别，不联网上传音频） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="弦歌"
        android:theme="@style/Theme.Songdu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BookstoreActivity"
            android:exported="false"
            android:label="添加书籍" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- v1.17.0 双声音选声页（首播门 / 设置重选共用） -->
        <activity
            android:name=".VoiceChoiceActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".CopySettingsActivity"
            android:exported="false" />

        <activity
            android:name=".TrackSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ReaderActivity"
            android:exported="false" />

        <activity
            android:name=".HelpActivity"
            android:exported="false" />

        <service
            android:name=".PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
