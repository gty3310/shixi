<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <!-- 顶栏：返回 / 书名 / 跟随恢复钮（沉浸模式整条隐藏） -->
    <LinearLayout
        android:id="@+id/readerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnReaderBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp"
            android:text="←"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/readerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFollow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_outline"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="⇓ 跟随"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <WebView
        android:id="@+id/readerWeb"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- v1.9.0 竖排固定注栏：注文不进竖排列流，改在页面下方固定一条显示当前句的注
         （可滚动看全文）＋同款页脚（点按切版本）。仅竖排＋注释开＋本书有注时由
         ReaderActivity 置为可见；左侧朱砂竖线与阅读页内的注高亮同色。 -->
    <LinearLayout
        android:id="@+id/readerNoteBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFE9DC"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#9E3B2B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/readerNoteScroll"
                android:layout_width="match_parent"
                android:layout_height="104dp">

                <TextView
                    android:id="@+id/readerNoteText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.15"
                    android:paddingLeft="12dp"
                    android:paddingTop="8dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="#4A4234"
                    android:textSize="12sp" />
            </ScrollView>

            <TextView
                android:id="@+id/readerNoteFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingTop="2dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp"
                android:textColor="#A97C2C"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- v1.16.0 点句面板：点任意一句后出现——写笔记＋三色标记（浅黄/浅绿/浅蓝）。
         默认收起一行（句预览＋笔记钮＋色点＋关闭）；点笔记钮展开输入区。 -->
    <LinearLayout
        android:id="@+id/sentPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFE9DC"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sentPanelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#4A4234"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSentNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:text="✎ 笔记"
                android:textColor="#9E3B2B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnMark1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="4dp"
                android:background="#F5DE8C"
                android:gravity="center"
                android:text=""
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnMark2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="6dp"
                android:background="#A9D3AC"
                android:gravity="center"
                android:text=""
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnMark3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="6dp"
                android:background="#A9C8E8"
                android:gravity="center"
                android:text=""
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSentClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="4dp"
                android:paddingBottom="4dp"
                android:text="✕"
                android:textColor="#8A8174"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sentNoteEditRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/sentNoteEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFDF7"
                android:gravity="top"
                android:hint="写下这一句的笔记……"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:minLines="2"
                android:padding="8dp"
                android:textColor="#26221C"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSentNoteCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="12dp"
                    android:paddingTop="6dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="2dp"
                    android:text="取消"
                    android:textColor="#8A8174"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSentNoteSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="12dp"
                    android:paddingTop="6dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="2dp"
                    android:text="保存"
                    android:textColor="#9E3B2B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部小播放栏（沉浸模式整条隐藏） -->
    <LinearLayout
        android:id="@+id/readerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/player_bg"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRBack15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_back15"
                android:drawablePadding="4dp"
                android:drawableTint="#FFFFFF"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp"
                android:text="15秒"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnRToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:paddingLeft="20dp"
                android:paddingTop="8dp"
                android:paddingRight="20dp"
                android:paddingBottom="8dp"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnRFwd15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:drawableRight="@drawable/ic_fwd15"
                android:drawableTint="#FFFFFF"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp"
                android:text="15秒"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnRSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:paddingLeft="10dp"
                android:paddingTop="8dp"
                android:paddingRight="10dp"
                android:paddingBottom="8dp"
                android:text="1.0×"
                android:textColor="#F0CDA0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnRLoop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingTop="8dp"
                android:paddingRight="6dp"
                android:paddingBottom="8dp"
                android:text="循环 开"
                android:textColor="#F0CDA0"
                android:textSize="13sp" />

            <!-- v1.21.0 循环范围：整书 / 单章（reader_prefs/loopScope，与章卡片同源） -->
            <TextView
                android:id="@+id/btnRLoopScope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="6dp"
                android:paddingTop="8dp"
                android:paddingRight="10dp"
                android:paddingBottom="8dp"
                android:text="整书循环"
                android:textColor="#F0CDA0"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="跟读 关"
                android:textColor="#F0CDA0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnRFollowChars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:paddingTop="6dp"
                android:paddingRight="8dp"
                android:paddingBottom="6dp"
                android:text="15字"
                android:textColor="#F0CDA0"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- v1.16.0 识读开关：用户领读、App 听读纠错（开＝朱砂实心 pill，同跟读口径） -->
            <TextView
                android:id="@+id/btnRRecite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="识读 关"
                android:textColor="#DDD6CB"
                android:textSize="13sp" />

            <!-- v1.9.0 注释开关：与跟读并列，呈现口径一致（开＝朱砂实心 pill） -->
            <TextView
                android:id="@+id/btnRNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="注释 关"
                android:textColor="#DDD6CB"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnRFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="Aa 字号"
                android:textColor="#DDD6CB"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnRScript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="简体"
                android:textColor="#DDD6CB"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnRPinyin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="注音 关"
                android:textColor="#DDD6CB"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnROrient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="竖排"
                android:textColor="#DDD6CB"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/readerFollowHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="#9C9484"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- v1.8.5 跟读调试读数：仅跟读开启时显示（过冲/落点实测），与说明行同风格 -->
        <TextView
            android:id="@+id/readerFollowDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="#9C9484"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 竖版分页页码（v1.8.0）：仅竖排时由 JS 桥回报后显示，不遮正文 -->
        <TextView
            android:id="@+id/readerPageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="#9C9484"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
